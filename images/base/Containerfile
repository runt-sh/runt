# runt base image: Debian (glibc, for compatibility with prebuilt wheels and
# native modules) plus the tools an agent reaches for first. `runt build`
# also runs its steps from this image, which is why erofs-utils is here.
FROM docker.io/library/debian:trixie-slim

# Keep docs, man pages and translations out of the image (dpkg honours this
# for everything installed later, too).
RUN printf '%s\n' \
      'path-exclude /usr/share/doc/*' 'path-include /usr/share/doc/*/copyright' \
      'path-exclude /usr/share/man/*' 'path-exclude /usr/share/info/*' \
      'path-exclude /usr/share/locale/*' 'path-include /usr/share/locale/locale.alias' \
      'path-exclude /usr/share/lintian/*' \
      > /etc/dpkg/dpkg.cfg.d/runt-minimal

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl erofs-utils git iproute2 iputils-ping procps \
 && find /usr/share/doc -mindepth 1 -not -name copyright -not -type d -delete \
 && rm -rf /usr/share/man/* /usr/share/info/* /usr/share/locale/*/ \
      /var/lib/apt/lists/* /var/cache/apt/*.bin /var/cache/debconf/*-old /var/log/apt /var/log/dpkg.log

# Shared folders are owned by the host user while the VM runs as root; this
# is a single-user dev VM, so trust every repository.
RUN git config --system --add safe.directory '*'
